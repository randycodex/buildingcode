      "html" : "<table cellSpacing=\"0\" style=\"width: 720px&#10;                ;\"><colgroup><col width=\"33.333%&#10;              \"><\/col><col width=\"33.333%&#10;              \"><\/col><col width=\"33.333%&#10;              \"><\/col><\/colgroup><tbody><tr><td style=\"word-wrap:break-word;padding-left:.075in;padding-right:.075in;padding-top:.022in;padding-bottom:.022in;border-top:1pt solid #000000;border-bottom:1pt solid #000000;border-left:1pt solid #000000;border-right:1pt solid #000000;\"><div><div style=\"text-align:center;\"><span style=\"font-weight: bold;font-style: normal;text-decoration:none;display: inline;\">Type of Work <\/span><\/div><\/div><\/td><td style=\"word-wrap:break-word;padding-left:.075in;padding-right:.075in;padding-top:.022in;padding-bottom:.022in;border-top:1pt solid #000000;border-bottom:1pt solid #000000;border-left:1pt solid #000000;border-right:1pt solid #000000;\"><div><div style=\"text-align:center;\"><span style=\"font-weight: bold;font-style: normal;text-decoration:none;display: inline;\">Minimum Lateral Pressure Assumed (psf)<\/span><\/div><\/div><\/td><td style=\"word-wrap:break-word;padding-left:.075in;padding-right:.075in;padding-top:.022in;padding-bottom:.022in;border-top:1pt solid #000000;border-bottom:1pt solid #000000;border-left:1pt solid #000000;border-right:1pt solid #000000;\"><div><div style=\"text-align:center;\"><span style=\"font-weight: bold;font-style: normal;text-decoration:none;display: inline;\">Limitations<\/span>&#160;<\/div><\/div><\/td><\/tr><tr><td style=\"word-wrap:break-word;padding-left:.075in;padding-right:.075in;padding-top:.022in;padding-bottom:.022in;border-top:1pt solid #000000;border-bottom:1pt solid #000000;border-left:1pt solid #000000;border-right:1pt solid #000000;\"><div><div style=\"text-align:center;\">Columns: Ordinary work with<br><\/br>normal internal vibration<\/div><\/div><\/td><td style=\"word-wrap:break-word;padding-left:.075in;padding-right:.075in;padding-top:.022in;padding-