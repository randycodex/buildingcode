ver 125 tons to 250 tons of refrigeration<\/div><\/div><\/td><td style=\"word-wrap:break-word;padding-left:.075in;padding-right:.075in;padding-top:.022in;padding-bottom:.022in;border-top:1pt solid #000000;border-bottom:1pt solid #000000;border-left:1pt solid #000000;border-right:1pt solid #000000;\"><div><div style=\"text-align:center;\">2 inches<\/div><\/div><\/td><\/tr><\/tbody><\/table>",
