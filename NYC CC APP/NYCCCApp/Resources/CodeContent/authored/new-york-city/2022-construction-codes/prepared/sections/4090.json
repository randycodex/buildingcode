      "html" : "<\/div><\/div><div><div style=\"margin-top:0pt;\"><\/div><\/div><\/div><div class=\"clearfix\"><\/div><div id=\"rid-0-0-0-179439\" class=\"rbox Normal-Level\"><AnnotationDrawer recordId=\"0-0-0-179439\"><\/AnnotationDrawer><div>&#160;&#160;&#160;where:<\/div><\/div><div class=\"clearfix\"><\/div><div id=\"rid-0-0-0-179440\" class=\"rbox Normal-Level\"><AnnotationDrawer recordId=\"0-0-0-179440\"><\/AnnotationDrawer><div><div style=\"\">&#160;&#160;&#160;&#160;&#160;&#160;<span style=\"font-weight: normal;font-style: italic;text-decoration:none;display: inline;\">P<\/span>&#160;&#160;&#160;=&#160;&#160;&#160;Allowable pile load in pounds.<\/div><\/div><\/div><div class=\"clearfix\"><\/div><div id=\"rid-0-0-0-179441\" class=\"rbox Normal-Level\"><AnnotationDrawer recordId=\"0-0-0-179441\"><\/AnnotationDrawer><div><div style=\"\">&#160;&#160;&#160;&#160;&#160;&#160;<span style=\"font-weight: normal;font-style: italic;text-decoration:none;display: inline;\">W<\/span><span style=\"font-weight: normal;font-style: italic;text-decoration:none;vertical-align: sub;display: inline;font-size:8pt;\">p<\/span>&#160;&#160;&#160;=&#160;&#160;&#160;Weight of pile in pounds.<\/div><\/div><\/div><div class=\"clearfix\"><\/div><div id=\"rid-0-0-0-179442\" class=\"rbox Normal-Level\"><AnnotationDrawer recordId=\"0-0-0-179442\"><\/AnnotationDrawer><div><div style=\"\">&#160;&#160;&#160;&#160;&#160;&#160;<span style=\"font-weight: normal;font-style: italic;text-decoration:none;display: inline;\">W<\/span><span style=\"font-weight: normal;font-style: italic;text-decoration:none;vertical-align: sub;display: inline;font-size:8pt;\">h<\/span>&#160;&#160;&#160;=&#160;&#160;&#160;Weight of striking part of hammer in pounds.<\/div><\/div><\/div><div class=\"clearfix\"><\/div><div id=\"rid-0-0-0-179443\" class=\"rbox Normal-Level\"><AnnotationDrawer recordId=\"0-0-0-179443\"><\/AnnotationDrawer><div><div style=\"\">&#160;&#160;&#160;&#160;&#160;&#160;<span style=\"font-weight: norm