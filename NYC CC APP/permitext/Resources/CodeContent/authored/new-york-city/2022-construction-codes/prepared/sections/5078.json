ap:break-word;padding-left:.075in;padding-right:.075in;padding-top:.022in;padding-bottom:.022in;border-top:1pt solid #000000;border-bottom:1pt solid #000000;border-left:1pt solid #000000;border-right:1pt solid #000000;\"><div class=\"Small\"><div style=\"text-align:center;margin-left:18pt;text-indent:-18pt;\">1.84<\/div><\/div><\/td><td style=\"word-wrap:break-word;padding-left:.075in;padding-right:.075in;padding-top:.022in;padding-bottom:.022in;border-top:1pt solid #000000;border-bottom:1pt solid #000000;border-left:1pt solid #000000;border-right:1pt solid #000000;\"><div class=\"Small\"><div style=\"text-align:center;margin-left:18pt;text-indent:-18pt;\">1.87<\/div><\/div><\/td><\/tr><\/tbody><\/table>",
