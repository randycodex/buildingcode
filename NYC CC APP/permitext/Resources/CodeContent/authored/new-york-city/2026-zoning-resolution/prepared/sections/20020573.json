":"N090239ZRY","reportURL":"http://a030-cpc.nyc.gov/html/cpc/report.aspx?num=N%20090239%20ZRY","projectName":"WATERFRONT PUBLIC ACCESS TEXT","action":"Amended","notes":"WF Design mods.","description":"TEXT CHANGE TO UPDATE DESIGN REGULATIONS & ADMINISTRATIVE REQUIREMENTS FOR WATERFRONT PUBLIC ACCESS AREAS WITH MINOR RELATED CHANGES TO BULK REGULATIONS"},{"effectiveDate":"2007-10-29","reportNumber":"N070448ZRY","reportURL":"http://a030-cpc.nyc.gov/html/cpc/report.aspx?num=N%20070448%20ZRY","projectName":"NEW ZONING DISTS","action":"Added","notes":"Bed-Stuy; moved from 123-672","description":"TEXT CHANGE TO ESTABLISH CITYWIDE DISTS R7D & C4-5D AS WELL AS A MIXED USE DIST M101/R7D"},{"effectiveDate":"2001-07-26","reportNumber":"N000244B1ZRY","reportURL":"http://a030-cpc.nyc.gov/html/cpc/report.aspx?num=N%20000244b1%20ZRY","projectName":"UNIFIED BULK PROGRAM","action":"Deleted","notes":"Mini-bulk; moved to 123-652","description":"MINOR MOD TO THE UNIFIED BULK PROGRAM TO CREATE A SPECIAL PERMIT FOR REDUCING OR ELIMINATING BONUS AMENITIES & A CERT FOR ANY REDUCTION CONTAINING A BONUS AMENITIES; CREATE A NEW CONTEXTUAL C2-5A DIST, A NEW SPEC DOWNTOWN BKLYN DIST AND"},{"effectiveDate":"1997-12-10","reportNumber":"N970751ZRX","reportURL":"http://a030-cpc.nyc.gov/html/cpc/report.aspx?num=N%20970751%20ZRX","projectName":"PORT MORRIS/SPECIAL MIXED-USE DIST","action":"Added","notes":null,"description":"TEXT CHANGE TO ESTABLISH A NEW SPEC MIXED USE DIST (ZR123) TO ALLOW COMMUNITY FACILITIES, RESD'L, COMM'L & MOST LIGHT MFG USES AS-OF-RIGHT WITHIN A PORTION OF PORT MORRIS"}],"amendmentHistorySourceURL":"https://zr.planning.nyc.gov/ajax/get/amendment/section/20573","effectiveDate":"2024-12-05","lastAmended":"2024-12-05","version":"NYC Zoning Resolution — text through 2026-07-16","researchEligibility":false}}
