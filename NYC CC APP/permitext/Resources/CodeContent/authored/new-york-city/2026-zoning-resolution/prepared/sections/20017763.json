border-bottom-width:0pt;width:72pt;border-top-color:</em></strong>000000;border-bottom-style:solid\">\n\t\t\t\n\n\t\t\t<p><span>to 1</span></p>\n\t\t\t</td>\n\t\t\t<td colspan=\"1\" rowspan=\"1\" style=\"border-right-style:solid;padding:0pt 6pt 0pt 6pt;border-bottom-color:<strong><em>000000;border-top-width:0pt;border-right-width:0pt;border-left-color:</em></strong>000000;vertical-align:top;border-right-color:<strong><em>000000;border-left-width:0pt;border-top-style:solid;border-left-style:solid;border-bottom-width:0pt;width:76.5pt;border-top-color:</em></strong>000000;border-bottom-style:solid\">\n\t\t\t\n\n\t\t\t<p><span>7.6</span></p>\n\t\t\t</td>\n\t\t\t<td colspan=\"1\" rowspan=\"1\" style=\"border-right-style:solid;padding:0pt 6pt 0pt 6pt;border-bottom-color:<strong><em>000000;border-top-width:0pt;border-right-width:0pt;border-left-color:</em></strong>000000;vertical-align:top;border-right-color:<strong><em>000000;border-left-width:0pt;border-top-style:solid;border-left-style:solid;border-bottom-width:0pt;width:72pt;border-top-color:</em></strong>000000;border-bottom-style:solid\">\n\t\t\t\n\n\t\t\t<p><span>to 1</span></p>\n\t\t\t</td>\n\t\t</tr></tbody></table>","plainText":"Depth of Optional Front Open Area (in feet) Alternate Sky Exposure Plane Height above Street Line (in feet) Slope over Zoning Lot (expressed as a ratio of vertical distance to horizontal distance) On Narrow Street On Wide Street On Narrow Street On Wide Street Vertical Distance Horizontal Distance Vertical Distance Horizontal Distance Within R1, R2, R3, R4, R5, R5A or R5B Districts 15 10 30 1.4 to 1 1.4 to 1 Within R6 or R7 Districts 15 10 60 3.7 to 1 7.6 to 1 Within R8, R9, R10, R11 or R12 Districts 15 10 85 3.7 to 1 7.6 to 1"},{"id":"zr-17763-block-006","kind":"html","html":"<p><span>However, in accordance with the provisions of Section <a class=\"sec-link-inline\" target=\"_blank\" href=\"https://zr.planning.nyc.gov/article-iii/chapter-2#32-42\" data-permitext-zr-source=\"https://zr.planning.nyc.gov/article-iii/chapter-2#32-42\"><span>32-42</span></a> (Location within Buildings), no <strong><em>commercial building</em></strong>, or portion thereof, occupied by non-<strong><em>residential uses</em></strong> listed under Use Groups VI through X shall exceed in height 30 feet or two <strong><em>stories</em></strong>, whichever is less.</span></p>","plainText":"However, in accordance with the provisions of Section 32-42 (Location within Buildings), no commercial building, or portion thereof, occupied by non-residential uses listed under Use Groups VI through X shall exceed in height 30 feet or two stories, whichever is less."},{"id":"zr-17763-block-007","kind":"html","html":"<p><span>For <strong><em>community facility buildings</em></strong> or <strong><em>buildings</em></strong> used for both <strong><em>community facility</em></strong> <strong><em>use</em></strong> and <strong><em>commercial</em></strong> <strong><em>use</em></strong>, when mapped within R4, R5, R5A or R5B Districts, the height above <strong><em>street line</em></strong> shall be 35 feet.</span></p>","plainText":"For community facility buildings or buildings used for both community facility use and commercial use, when mapped within R4, R5, R5A or R5B Districts, the height above street line shall be 35 feet."}],"zoning":{"schemaVersion":1,"sourceNodeID":17763,"sourcePath":"/article-iii/chapter-3/33-441","sourceURL":"https://zr.planning.nyc.gov/article-iii/chapter-3/33-441","sourceContentHash":"332ddeb8abeb096f23d7503645e7e513f4f2cb318a081bb5fa4454487f1ebdac","article":{"roman":"III","title":"Commercial District Regulations"},"chapter":{"number":"3","title":"Bulk Regulations for Commercial or Community Facility Buildings in Commercial Districts","canonicalNumber":"III-3"},"appendix":null,"subsections":[{"id":"zr-17763-sub-89f65cb5b42687de","label":"1.4","sourceAnchor":null,"plainText":"1.4","ordinal":0},{"id":"zr-17763-sub-3dc5073eb4855aad","label":"3.7","sourceAnchor":null,"plainTe