>000000;border-bottom-style:solid\">\n\t\t\t\n\n\t\t\t<p><span>34th Street-Penn Station</span></p>\n\t\t\t</td>\n\t\t\t<td colspan=\"1\" rowspan=\"1\" style=\"border-right-style:solid;padding:0pt 6pt 0pt 6pt;border-bottom-color:<strong><em>000000;border-top-width:0pt;border-right-width:0pt;border-left-color:</em></strong>000000;vertical-align:top;border-right-color:<strong><em>000000;border-left-width:0pt;border-top-style:solid;border-left-style:solid;border-bottom-width:0pt;width:193.5pt;border-top-color:</em></strong>000000;border-bottom-style:solid\">\n\t\t\t\n\n\t\t\t<p><span>8th Avenue</span></p>\n\t\t\t</td>\n\t\t</tr><tr style=\"height:0pt\"><td colspan=\"1\" rowspan=\"1\" style=\"border-right-style:solid;padding:0pt 6pt 0pt 6pt;border-bottom-color:<strong><em>000000;border-top-width:0pt;border-right-width:0pt;border-left-color:</em></strong>000000;vertical-align:top;border-right-color:<strong><em>000000;border-left-width:0pt;border-top-style:solid;border-left-style:solid;border-bottom-width:0pt;width:211.5pt;border-top-color:</em></strong>000000;border-bottom-style:solid\">\n\t\t\t\n\n\t\t\t<p><span>59th Street/Lexington Avenue-60th St.</span></p>\n\t\t\t</td>\n\t\t\t<td colspan=\"1\" rowspan=\"1\" style=\"border-right-style:solid;padding:0pt 6pt 0pt 6pt;border-bottom-color:<strong><em>000000;border-top-width:0pt;border-right-width:0pt;border-left-color:</em></strong>000000;vertical-align:top;border-right-color:<strong><em>000000;border-left-width:0pt;border-top-style:solid;border-left-style:solid;border-bottom-width:0pt;width:193.5pt;border-top-color:</em></strong>000000;border-bottom-style:solid\">\n\t\t\t\n\n\t\t\t<p><span>Lexington Avenue and Broadway-60th Street</span></p>\n\t\t\t</td>\n\t\t</tr><tr style=\"height:0pt\"><td colspan=\"1\" rowspan=\"1\" style=\"border-right-style:solid;padding:0pt 6pt 0pt 6pt;border-bottom-color:<strong><em>000000;border-top-width:0pt;border-right-width:0pt;border-left-color:</em></strong>000000;vertical-align:top;border-