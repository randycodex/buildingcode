r-left-width:0pt;border-top-style:solid;border-left-style:solid;border-bottom-width:0pt;width:148.5pt;border-top-color:</em></strong>000000;border-bottom-style:solid\">\n\t\t\t\n\n\t\t\t<p><span>14.5</span></p>\n\t\t\t</td>\n\t\t</tr><tr style=\"height:0pt\"><td colspan=\"1\" rowspan=\"1\" style=\"border-right-style:solid;padding:0pt 6pt 0pt 6pt;border-bottom-color:<strong><em>000000;border-top-width:0pt;border-right-width:0pt;border-left-color:</em></strong>000000;vertical-align:top;border-right-color:<strong><em>000000;border-left-width:0pt;border-top-style:solid;border-left-style:solid;border-bottom-width:0pt;width:85.5pt;border-top-color:</em></strong>000000;border-bottom-style:solid\">\n\t\t\t\n\n\t\t\t<p><span>R5</span></p>\n\t\t\t</td>\n\t\t\t<td colspan=\"1\" rowspan=\"1\" style=\"border-right-style:solid;padding:0pt 6pt 0pt 6pt;border-bottom-color:<strong><em>000000;border-top-width:0pt;border-right-width:0pt;border-left-color:</em></strong>000000;vertical-align:top;border-right-color:<strong><em>000000;border-left-width:0pt;border-top-style:solid;border-left-style:solid;border-bottom-width:0pt;width:153pt;border-top-color:</em></strong>000000;border-bottom-style:solid\">\n\t\t\t\n\n\t\t\t<p><span>.25</span></p>\n\t\t\t</td>\n\t\t\t<td colspan=\"1\" rowspan=\"1\" style=\"border-right-style:solid;padding:0pt 6pt 0pt 6pt;border-bottom-color:<strong><em>000000;border-top-width:0pt;border-right-width:0pt;border-left-color:</em></strong>000000;vertical-align:top;border-right-color:<strong><em>000000;border-left-width:0pt;border-top-style:solid;border-left-style:solid;border-bottom-width:0pt;width:148.5pt;border-top-color:</em></strong>000000;border-bottom-style:solid\">\n\t\t\t\n\n\t\t\t<p><span>10.0</span></p>\n\t\t\t</td>\n\t\t</tr></tbody></table>","plainText":"District Increase in Floor Area Ratio Decrease in Open Space Ratio R4 .25 14.5 R5 .25 10.0"},{"id":"zr-19266-block-004","kind":"html","html":"<p><span>For any <strong><em>large-scale residential developments</em></strong> comprising <strong><em>buildings</em></strong> of not more than four <strong><em>stories</em></strong> receiving a bonus under this Section, the Commission may modify where appropriate the requirements of Section <a class=\"sec-link-inline\" target=\"_blank\" href=\"https://zr.planning.nyc.gov/article-ii/chapter-3#23-734\" data-permitext-zr-source=\"https://zr.planning.nyc.gov/article-ii/chapter-3#23-734\"><span>23-734</span></a>&nbsp;(Permitted obstructions in open space).</span></p>","plainText":"For any large-scale residential developments comprising buildings of not more than four stories receiving a bonus under this Section, the Commission may modify where appropriate the requirements of Section 23-734 (Permitted obstructions in open space)."}],"zoning":{"schemaVersion":1,"sourceNodeID":19266,"sourcePath":"/article-vii/chapter-8/78-353","sourceURL":"https://zr.planning.nyc.gov/article-vii/chapter-8/78-353","sourceContentHash":"15dbf6e4b0ff4c7f2acace0b70453b5296ba5e392e90d9fc516db1b600d210e0","article":{"roman":"VII","title":"Administration"},"chapter":{"number":"8","title":"Special Regulations Applying to Large-Scale Residential Developments","canonicalNumber":"VII-8"},"appendix":null,"subsections":[{"id":"zr-19266-sub-a83e9dc880b73931","label":"14.5","sourceAnchor":null,"plainText":"14.5","ordinal":0},{"id":"zr-19266-sub-0651902241f5ff60","label":"10.0","sourceAnchor":null,"plainText":"10.0","ordinal":1}],"tables":[{"id":"zr-19266-table-001","ordinal":0,"sourceAnchor":null,"caption":null,"plainText":"District Increase in Floor Area Ratio Decrease in Open Space Ratio R4 .25 14.5 R5 .25 10.0","contentHash":"e0fc97aa1e5061b0013d22b8ff39b661e591e5a58e11dbfa1ceb50fedf15d098"}],"mapReferences":[],"appendixReferences":[],"specialDistrict":{"name":"Special Regulations Applying to Large-Scale Residential Developments","abbreviation":null},"amendmentHistory":[{"effectiveDate":"2023-12-06","reportNumber":"N230113ZRY","reportURL":"http://a030-cpc.nyc.