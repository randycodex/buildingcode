# Reviewed example only. Do not copy over an existing environment wholesale.
# Server-side settings; no public prefix. V2 stays off until explicitly enabled.
PERMITEXT_RESEARCH_V2=0
PERMITEXT_RESEARCH_V2_ROLLOUT=allowlist
PERMITEXT_RESEARCH_V2_USERS=
PERMITEXT_RESEARCH_V2_DEFAULT=legacy

# Reuse the deployed OPENAI_API_KEY and PostgreSQL connection secret.
# Reuse existing base-model pricing, auth, entitlements, usage and billing.
# Never set PERMITEXT_RESEARCH_V2_BUDGET_PATH or PERMITEXT_RESEARCH_EVAL_MAX_USD
# in a deployed environment. Those belong to isolated local paid tests only.

# Example application caps in USD; shared with existing Research.
# Keep stricter existing caps or choose explicit business limits before activation.
PERMITEXT_RESEARCH_MAX_REQUEST_USD=0.25
PERMITEXT_RESEARCH_USER_DAILY_CAP_USD=1
PERMITEXT_RESEARCH_USER_MONTHLY_CAP_USD=10
PERMITEXT_RESEARCH_DAILY_CAP_USD=10
PERMITEXT_RESEARCH_MONTHLY_CAP_USD=100

# Luna Standard model-specific accounting. Preserve the existing base-model rates.
# Official prices checked 2026-10-27; refresh pricing before future activation.
PERMITEXT_RESEARCH_FAST_MODEL=gpt-6-luna
PERMITEXT_RESEARCH_FAST_INPUT_USD_PER_MILLION_TOKENS=0.10
PERMITEXT_RESEARCH_FAST_CACHED_INPUT_USD_PER_MILLION_TOKENS=0.01
PERMITEXT_RESEARCH_FAST_OUTPUT_USD_PER_MILLION_TOKENS=0.50
PERMITEXT_RESEARCH_FAST_PRICING_VERSION=luna-standard-20261027

# First opt in a known backend user ID and enable the master switch.
# Set DEFAULT=v2 to open v2 automatically for eligible accounts.
# Set ROLLOUT=all only for a deliberate broad release.
# Roll back by setting V2=0. Saved answers and their exact evidence stay readable.
