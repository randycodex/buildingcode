{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run verify:deploy-content && npm run build:workboard",
  "outputDirectory": "public",
  "rewrites": [
    {
      "source": "/",
      "destination": "/api/index"
    },
    {
      "source": "/(.*)",
      "destination": "/api/index"
    }
  ]
}
